# Copy to .env.local. Supply your own accounts; these are variable names only.
# Next.js browser + server
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=
ROOFREPLY_SERVICE_SECRET=
TELNYX_PUBLIC_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# Also configure these on YOUR Convex deployment where actions execute.
# The issuer and service secret must match Next.js.
OPENAI_API_KEY=
TELNYX_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
OPS_ADMIN_CLERK_IDS=

# Optional, only for the corresponding features
TELNYX_MESSAGING_PROFILE_ID=
NEXT_PUBLIC_META_PIXEL_ID=
DEMO_SMS_TELNYX_PHONE_NUMBER=
DEMO_SMS_OPT_IN_WEBHOOK_URL=
DEMO_SMS_OPT_IN_WEBHOOK_SECRET=

# Keep indexing disabled for a personal development copy.
ROOFREPLY_INDEXING_ENABLED=false
