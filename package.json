{
  "name": "roof-reply-public",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "agents/social",
    "agents/roofing-lead",
    "packages/brand"
  ],
  "scripts": {
    "rescue-kit:assets": "node --import tsx scripts/generate-rescue-kit.ts",
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types \"lib/**/*.test.ts\" \"agents/social/src/**/*.test.ts\"",
    "test:agents": "npm run test --workspace @roofreply/social-agent",
    "typecheck:workspaces": "npm run typecheck --workspaces",
    "start": "next start",
    "test:backend": "node --import tsx --test tests/*.test.ts",
    "test:all": "npm test && npm run test:backend"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.3",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@roofreply/brand": "0.1.0",
    "@roofreply/social-agent": "0.1.0",
    "@vercel/analytics": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.30.0",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.12.25",
    "lucide-react": "^0.454.0",
    "next": "^16.2.6",
    "posthog-js": "^1.390.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.5.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "allowScripts": {
    "@clerk/shared@3.47.5": true,
    "core-js@3.47.0": true,
    "esbuild@0.25.4": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
